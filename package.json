{
  "name": "pwa-player-monorepo",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "pnpm --filter pwa-audio-player build",
    "build:pages": "node scripts/build-pages.js",
    "publish:npm": "pnpm build:core && pnpm --filter pwa-audio-player publish --access public --no-git-checks",
    "deploy:pages": "pnpm run build:pages && wrangler pages deploy dist-pages --project-name=pwa-audio-player --branch=main",
    "test": "pnpm build:core && node --test packages/core/test/*.test.js",
    "dev:demos": "node scripts/dev-demos.js",
    "dev:hub": "pnpm --filter example-hub dev",
    "dev:vanilla": "pnpm --filter example-vanilla dev",
    "dev:react": "pnpm --filter example-react dev",
    "dev:vue": "pnpm --filter example-vue dev",
    "dev:svelte": "pnpm --filter example-svelte dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.4.0",
    "vite-plugin-qrcode": "^0.4.1",
    "wrangler": "^4.156.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
