{
  "name": "pwa-audio-player",
  "version": "1.4.0",
  "description": "Universal PWA & Web audio player engine that eliminates iOS Safari lockscreen freeze-lock deadlocks and background stutters.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "keywords": [
    "pwa",
    "player",
    "audio",
    "ios",
    "safari",
    "mediasession",
    "lockscreen",
    "background-audio",
    "keep-alive",
    "silent-hold"
  ],
  "author": "ajaxsys",
  "license": "MIT",
  "homepage": "https://github.com/ajaxsys/pwa-audio-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaxsys/pwa-audio-player.git"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
